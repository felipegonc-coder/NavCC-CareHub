# Care Hub settings, read by docker-compose.yml. install.sh copies this file to
# .env and fills in random secrets. .env stays on the server only (mode 600).

# Web address: a Tailscale name (*.ts.net) or a public domain, and the same as a URL.
CAREHUB_DOMAIN=carehub.example.ts.net
CAREHUB_PUBLIC_URL=https://carehub.example.ts.net
# Cookies only over HTTPS. Caddy always serves HTTPS, so keep this on.
COOKIE_SECURE=true
# Address Caddy listens on (ports 80 and 443). Empty: every address of the server.
# The tailnet IP (tailscale ip -4): reachable only over Tailscale. Empty for a public domain.
CAREHUB_BIND_ADDRESS=
# true: the 03:00 timer run pulls newer images (PostgreSQL 17.x, Caddy 2.x). The app
# keeps the version in docker-compose.yml either way. See README.md.
CAREHUB_AUTO_UPDATE=false
TZ=America/Denver

POSTGRES_USER=carehub
POSTGRES_DB=carehub
POSTGRES_PASSWORD=change-me
# Must match the three values above.
DATABASE_URL=postgres://carehub:change-me@db:5432/carehub
# Signing key: 32 or more random bytes (install.sh creates one).
SESSION_SECRET=change-me

# Nightly backups: time (in TZ) and how many days to keep.
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=30
