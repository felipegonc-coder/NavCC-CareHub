# Care Hub settings, read by docker-compose.yml. install.sh copies this file to .env,
# fills in this server's values and random secrets, and makes it readable by root only
# (mode 600). .env never leaves the server. Values here are placeholders.

# --- Server ---
# The server's Tailscale name, e.g. carehub.tail1234.ts.net
CAREHUB_DOMAIN=carehub.example.ts.net
# The web address, required in production: https:// and CAREHUB_DOMAIN
CAREHUB_PUBLIC_URL=https://carehub.example.ts.net
# Cookies only over HTTPS. Caddy always serves HTTPS, so keep this true.
COOKIE_SECURE=true
# The server's Tailscale IPv4 address (tailscale ip -4); Caddy listens only there
CAREHUB_TAILSCALE_IP=100.64.0.1
# Where the database, uploaded files, backups and certificates live
CAREHUB_DATA_DIR=/srv/carehub
# Numeric user and group of the Care Hub service user (id -u carehub, id -g carehub)
CAREHUB_UID=999
CAREHUB_GID=999
# Time zone for the database and the backup time
TZ=America/Denver
# CAREHUB_VERSION and CAREHUB_BUILD_DATE are set by up.sh when it builds the image.

# --- Database ---
# Database user and name
POSTGRES_USER=carehub
POSTGRES_DB=carehub
# Database password (install.sh makes a random one)
POSTGRES_PASSWORD=change-me
# How the app connects: the user, password and name above, at db:5432
DATABASE_URL=postgres://carehub:change-me@db:5432/carehub

# --- Backups ---
# Daily backup time, in TZ
BACKUP_AT=02:00
# Days to keep backups
BACKUP_KEEP_DAYS=30

# --- Team tools (all optional; a missing value switches only that feature off) ---
# Google Calendar (read-only): an OAuth client of type "Web application",
# redirect URL <CAREHUB_PUBLIC_URL>/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web push (notifications when Care Hub isn't open). Make the pair with the
# command in docs/team/settings.md.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Encrypts stored calendar connections: openssl rand -base64 32
CALENDAR_SECRET_KEY=
# Claude features (they stay off until an admin turns them on)
ANTHROPIC_API_KEY=
# Folder with the speech model files for private transcription
MODELS_DIR=
