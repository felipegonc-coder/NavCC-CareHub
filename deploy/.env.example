# Care Hub settings, read by docker-compose.yml. install.sh copies this file to
# .env and fills in random secrets. .env stays on the server only (mode 600).

# Web address: a Tailscale name (*.ts.net) or a public domain.
CAREHUB_DOMAIN=carehub.example.ts.net
# Put a sha-<commit> tag here to hold or roll back a version.
CAREHUB_IMAGE=ghcr.io/felipegonc-coder/navcc-carehub:latest
TZ=America/Denver

POSTGRES_USER=carehub
POSTGRES_DB=carehub
POSTGRES_PASSWORD=change-me
# Must match the three values above.
DATABASE_URL=postgres://carehub:change-me@db:5432/carehub
SESSION_SECRET=change-me

# Nightly backups: time (in TZ) and how many days to keep.
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=30
