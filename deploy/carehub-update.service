[Unit]
Description=Care Hub: nightly updates if CAREHUB_AUTO_UPDATE=true, Tailscale socket check
Documentation=file:///opt/carehub/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/bin/bash /opt/carehub/update.sh --timer
TimeoutStartSec=15min
