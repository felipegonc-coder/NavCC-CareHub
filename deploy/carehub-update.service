[Unit]
Description=Care Hub: pull new images and restart what changed
Documentation=file:///opt/carehub/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/bin/bash /opt/carehub/update.sh
TimeoutStartSec=15min
